<Project Sdk="Microsoft.NET.Sdk">
  <!--
    VTX 独立测试工程：运行时（配合 Godot API 桩）+ Roslyn 分析器/生成器。
    运行方法见 Godot/README.md 的“测试”一节。
    默认通过 NuGet 引用 Roslyn 4.8（支持 C# 12 的用例）；分析器本身仍由 Godot.SourceGenerators 用 Roslyn 3.11 编译，API 兼容性在引擎构建时检查。
    离线环境可设置 MSBuild 属性 RoslynDir 指向 dotnet SDK 的 Roslyn/bincore 目录，直接引用 SDK 自带的编译器程序集。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);RS1035;RS1036;RS1041;RS1042;RS2008;CS8632;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\runtime\*.cs" LinkBase="runtime" />
    <Compile Include="..\analyzers\*.cs" LinkBase="analyzers" />
    <None Include="Cases\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\runtime\*.cs" LinkBase="sources\runtime" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GodotStubs.cs" Link="sources\GodotStubs.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\Examples.cs" LinkBase="sources\docs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RoslynDir)' == ''">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(RoslynDir)' != ''">
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(RoslynDir)/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(RoslynDir)/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
